# Firebase web app values are public configuration, not server credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Keep provider secrets server-side. An OpenAI-compatible endpoint is supported.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Image provider: compatible with /images/generations and optional /images/{action} endpoints.
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_BASE_URL=

# Voice provider: OpenAI-compatible audio transcription and speech endpoints.
VOICE_PROVIDER_API_KEY=
VOICE_PROVIDER_BASE_URL=https://api.openai.com/v1
VOICE_TRANSCRIPTION_MODEL=whisper-1
VOICE_SPEECH_MODEL=tts-1

# Firebase Admin SDK service-account JSON (server only), required for protected API routes.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional PDF text extraction service. It must accept multipart `file` and return { "text": "..." }.
PDF_TEXT_EXTRACTION_URL=
PDF_TEXT_EXTRACTION_API_KEY=

# Optional extractor for DOCX and image formats. Multipart fields: file, mimeType.
DOCUMENT_EXTRACTION_URL=
DOCUMENT_EXTRACTION_API_KEY=