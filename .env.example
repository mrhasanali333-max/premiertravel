# Firebase Web App values are public configuration, not server credentials.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=

# OpenAI-compatible text provider.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Image provider: base URL should expose /images/generations and optional /images/{action} endpoints.
IMAGE_PROVIDER_API_KEY=
IMAGE_PROVIDER_BASE_URL=

# Voice provider uses OpenAI-compatible /audio/transcriptions and /audio/speech endpoints.
VOICE_PROVIDER_API_KEY=
VOICE_PROVIDER_BASE_URL=https://api.openai.com/v1
VOICE_TRANSCRIPTION_MODEL=whisper-1
VOICE_SPEECH_MODEL=tts-1

# PDF extraction: multipart `file` endpoint returning { "text": "..." }.
PDF_TEXT_EXTRACTION_URL=
PDF_TEXT_EXTRACTION_API_KEY=

# Optional document extractor for DOCX/image types, with `file` and `mimeType` form fields.
DOCUMENT_EXTRACTION_URL=
DOCUMENT_EXTRACTION_API_KEY=