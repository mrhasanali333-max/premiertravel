rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function createsForSelf() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, delete: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && (!('planId' in request.resource.data) || request.resource.data.planId == 'free')
        && request.resource.data.keys().hasOnly(['userId', 'displayName', 'email', 'photoURL', 'favoriteTools', 'createdAt', 'updatedAt']);
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.userId == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'favoriteTools', 'updatedAt']);
    }

    match /conversations/{conversationId} {
      allow read, delete: if ownsDocument();
      allow create: if createsForSelf();
      allow update: if ownsDocument() && request.resource.data.userId == resource.data.userId;

      match /messages/{messageId} {
        function ownsConversation() {
          return signedIn()
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
        }
        allow read, delete: if ownsConversation();
        allow create: if ownsConversation() && request.resource.data.userId == request.auth.uid;
        allow update: if ownsConversation()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userId == request.auth.uid;
      }
    }

    match /files/{fileId} {
      allow read, delete: if ownsDocument();
      allow create: if createsForSelf();
      allow update: if ownsDocument() && request.resource.data.userId == resource.data.userId;
    }

    match /images/{imageId} {
      allow read: if ownsDocument();
      allow write: if false;
    }

    match /history/{historyId} {
      allow read, delete: if ownsDocument();
      allow create: if createsForSelf();
      allow update: if ownsDocument() && request.resource.data.userId == resource.data.userId;
    }

    match /usage/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;

      match /daily/{date} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /agentRuns/{runId} {
      allow read: if ownsDocument();
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if ownsDocument();
      allow create, delete: if false;
      allow update: if ownsDocument()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
    }
  }
}