rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function createsForSelf() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /conversations/{conversationId} {
      allow read, delete: if ownsDocument();
      allow create: if createsForSelf();
      allow update: if ownsDocument() && request.resource.data.userId == resource.data.userId;

      match /messages/{messageId} {
        function ownsConversation() {
          return signedIn()
            && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
        }
        allow read, delete: if ownsConversation();
        allow create: if ownsConversation() && request.resource.data.userId == request.auth.uid;
        allow update: if ownsConversation()
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.userId == request.auth.uid;
      }
    }

    match /files/{fileId} {
      allow read, delete: if ownsDocument();
      allow create: if createsForSelf();
      allow update: if ownsDocument() && request.resource.data.userId == resource.data.userId;
    }

    match /history/{historyId} {
      allow read, delete: if ownsDocument();
      allow create: if createsForSelf();
      allow update: if ownsDocument() && request.resource.data.userId == resource.data.userId;
    }

    match /usage/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}